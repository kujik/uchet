    RtfText = 
      '{\rtf1\ansi\ansicpg1251\deff0\nouicompat\deflang1049{\fonttbl{\f' +
      '0\froman\fprq2\fcharset204 Times New Roman;}{\f1\fnil\fcharset20' +
      '4 Segoe UI;}}'#13#10'{\colortbl ;\red30\green109\blue176;\red0\green0\' +
      'blue0;\red51\green51\blue51;}'#13#10'{\stylesheet{ Normal;}{\s1 headin' +
      'g 1;}{\s2 heading 2;}{\s3 heading 3;}}'#13#10'{\*\generator Riched20 1' +
      '0.0.19041}\viewkind4\uc1 '#13#10'\pard\widctlpar\s2\sl360\slmult0\qc\c' +
      'f1\b\f0\fs32 Why was\~EhLib\~chosen in more\par'#13#10#13#10'\pard\widctlp' +
      'ar\s2\sa30\sl360\slmult0\qc than 80 countries around the world?\' +
      'par'#13#10#13#10'\pard\widctlpar\s3\sl360\slmult0\qc EhLib\~is powerful an' +
      'd therewith intuitive to use!\par'#13#10#13#10'\pard\widctlpar\qj\cf2\b0\f' +
      's24 Using the library, you will receive:\cf3\par'#13#10'-      Maximum' +
      '\~of\~enclosed\~functional during the work with tabular data.\pa' +
      'r'#13#10'-      Time saving for developer\~\endash  display your data ' +
      'in the right format without writing software code.\par'#13#10'-      F' +
      'ast\~and intuitive\~exploration\~of the library.\par'#13#10'-      Gre' +
      'at number of examples, instructions and help-files.\par'#13#10'-      ' +
      'High speed of applications\~\endash  development involves a spec' +
      'ial optimization stage of speed for each component of library.\p' +
      'ar'#13#10'-      Easy debug final product. EhLib is 100% native VCL li' +
      'brary written in Delphi language.\par'#13#10'-      As a result the us' +
      'er will\~receive an understandable, beautiful and easy-to-use in' +
      'terface\~with impressive features of information processing.\par' +
      #13#10#13#10'\pard\cf0\f1\fs18\par'#13#10'}'#13#10#0
  end
