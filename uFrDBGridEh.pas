procedure TFrDBGridEh.UpdatePickKeyList(const AFieldName: string; APickList, AKeyList: TVarDynArray; ALimitTextToListValues: Boolean; AAlwaysShowEditButton: Boolean);
//пересоздадим выпадающий список в столбце
