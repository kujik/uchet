  ACol, ARow: Integer;
  AreaCol, AreaRow: Integer;
  Area: TCellAreaTypeEh;
begin
  //получим параметры области
  Area := DBGridEh1.GetCellAreaType(ACol, ARow, AreaCol, AreaRow);
  var xx := Cell.X;
